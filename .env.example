# LLM API keys — copy this to .env and fill in your own keys
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Server-side control
LLM_ENABLED=true
LLM_TIMEOUT_SEC=30
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.4

# Server-side visual review for ambiguous OMR regions. Never expose this key in frontend code.
OMR_API_KEY=
OMR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OMR_API_STYLE=chat
OMR_VISION_MODEL=qwen3-vl-flash
OMR_NOTATION_VISION_MODEL=qwen3.6-flash
OMR_VISION_ESCALATION_MODEL=qwen3.7-plus

# Optional fine-tuned HOMR model override. Leave unset to use official weights.
HOMR_ENCODER_MODEL=
HOMR_DECODER_MODEL=
HOMR_PYTORCH_CHECKPOINT=
OMR_VISION_TIMEOUT_SEC=60
